rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // submissions 컬렉션: 누구나 읽고(발표 화면), 누구나 새 메뉴를 제출할 수 있음(학생, 로그인 불필요).
    // 크기/필드를 제한해서 이상한 데이터가 들어오는 것을 최소한으로 막습니다.
    match /submissions/{docId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(
                        ['name', 'korean', 'culture', 'desc', 'country', 'image', 'createdAt']
                      )
                    && request.resource.data.name is string
                    && request.resource.data.name.size() < 60
                    && request.resource.data.image is string
                    && request.resource.data.image.size() < 900000; // 약 0.9MB 제한

      // 학생은 자기 제출을 수정/삭제할 수 없고, 교사가 발표 화면의 "전체 삭제"로만 정리합니다.
      allow update: if false;
      allow delete: if true;
    }
  }
}
